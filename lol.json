{
  "id": "tmdb-full-catalog",
  "name": "TMDB Full Catalog",
  "version": "1.2.1",
  "description": "Catálogo completo TMDB: home con catálogos de géneros y franquicias, discover, meta+IntroDB y extractores latinos.",
  "author": "community",
  "repo": "tmdb-full-catalog",
  "entry": "plugin.js",
  "main": "plugin.js",
  "icon": "icon.png",
  "banner": "https://image.tmdb.org/t/p/w1280/uDgy6hyPd82kOHh6e0smXGXwPOe.jpg",
  "color": "#01B4E4",
  "apiVersion": 6,
  "browser": false,
  "section": {
    "label": "TMDB Full"
  },
  "languages": [
    "es",
    "es-MX",
    "es-ES",
    "en"
  ],
  "capabilities": [
    "home",
    "discover",
    "search",
    "meta",
    "streams",
    "catalogs"
  ],
  "tabs": [
    "home",
    "discover",
    "search",
    "library",
    "settings"
  ],
  "newsImageStyle": "banner",
  "episodesPagination": {
    "enabled": true,
    "perPage": 40
  },
  "theme": {
    "accent": "#01B4E4",
    "onAccent": "#FFFFFF",
    "background": "#0B0E14",
    "surface": "#1A222D",
    "highlight": "#7DD3FC"
  },
  "config": [
    {
      "key": "tmdb_api_key",
      "label": "API Key TMDB (opcional)",
      "type": "text",
      "default": "",
      "placeholder": "Vacío = clave del addon",
      "description": "Tu propia API key de themoviedb.org si la tienes."
    },
    {
      "key": "tmdb_lang",
      "label": "Idioma de metadatos",
      "type": "select",
      "default": "es-ES",
      "description": "Idioma de títulos y descripciones.",
      "options": [
        {
          "id": "es-MX",
          "label": "Español (México)"
        },
        {
          "id": "es-ES",
          "label": "Español (España)"
        },
        {
          "id": "en-US",
          "label": "English"
        }
      ]
    },
    {
      "key": "image_quality",
      "label": "Calidad de posters",
      "type": "select",
      "default": "w500",
      "options": [
        {
          "id": "w185",
          "label": "Baja (w185)"
        },
        {
          "id": "w342",
          "label": "Media (w342)"
        },
        {
          "id": "w500",
          "label": "Alta (w500)"
        },
        {
          "id": "w780",
          "label": "Muy alta (w780)"
        },
        {
          "id": "original",
          "label": "Original"
        }
      ]
    },
    {
      "key": "backdrop_quality",
      "label": "Calidad de backdrops",
      "type": "select",
      "default": "w1280",
      "options": [
        {
          "id": "w780",
          "label": "w780"
        },
        {
          "id": "w1280",
          "label": "w1280"
        },
        {
          "id": "original",
          "label": "Original"
        }
      ]
    },
    {
      "key": "region",
      "label": "Región TMDB",
      "type": "text",
      "default": "ES",
      "placeholder": "ES, MX, US, AR…"
    },
    {
      "key": "exclude_in_theater",
      "label": "Ocultar solo-en-cines (solo digital)",
      "type": "select",
      "default": "true",
      "description": "No listar títulos que aún no tienen versión digital.",
      "options": [
        {
          "id": "true",
          "label": "Sí, solo digital"
        },
        {
          "id": "false",
          "label": "No, mostrar también cines"
        }
      ]
    },
    {
      "key": "include_theater",
      "label": "Mostrar fila En cines en Home",
      "type": "select",
      "default": "false",
      "options": [
        {
          "id": "true",
          "label": "Mostrar"
        },
        {
          "id": "false",
          "label": "Ocultar"
        }
      ]
    },
    {
      "key": "only_digital",
      "label": "Solo fechas ya lanzadas",
      "type": "select",
      "default": "true",
      "options": [
        {
          "id": "true",
          "label": "Sí"
        },
        {
          "id": "false",
          "label": "No"
        }
      ]
    },
    {
      "key": "hide_unreleased_eps",
      "label": "Ocultar capítulos no estrenados",
      "type": "select",
      "default": "true",
      "options": [
        {
          "id": "true",
          "label": "Sí"
        },
        {
          "id": "false",
          "label": "No"
        }
      ]
    },
    {
      "key": "enabled_sources",
      "label": "Extractores activos (coma)",
      "type": "text",
      "default": "embed69,homecine,seriesmetro,cinecalidad,verpelis,vimeus,lamovie,elifilms,tioplus,cine24h,cinemitas,hackstore,areshd,sololatino,pelisgratishd,peliculasflix,entrepeliculasyseries,pelisgo,fuegocine",
      "description": "Quita nombres para desactivar servidores."
    },
    {
      "key": "max_concurrent_sources",
      "label": "Extractores en paralelo",
      "type": "number",
      "default": "4"
    }
  ]
}