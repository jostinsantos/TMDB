{
  "id": "tmdb-full-catalog",
  "name": "TMDB Full Catalog",
  "version": "1.2.0",
  "description": "Catálogo completo TMDB: home con novedades/géneros/franquicias, discover (tipo·género·orden), meta+logo+IMDb+IntroDB y extractores latinos embebidos.",
  
  "icon": "icon.png",
  "banner": "https://image.tmdb.org/t/p/w1280/uDgy6hyPd82kOHh6e0smXGXwPOe.jpg",
  "color": "#01B4E4",
  "author": "community",
  "languages": [
    "es",
    "es-MX",
    "es-ES",
    "en"
  ],
  "entry": "plugin.js",
  "main": "plugin.js",
  "capabilities": [
    "home",
    "discover",
    "search",
    "meta",
    "streams",
    "catalogs"
  ],
  "pages": [
    "home",
    "discover",
    "search",
    "meta",
    "streams",
    "catalogs"
  ],
  "types": [
    "movie",
    "series"
  ],
  "contentTypes": [
    "movie",
    "series"
  ],
  "apiVersion": 1,
  "config": [
    {
      "key": "tmdb_api_key",
      "label": "API Key TMDB (opcional)",
      "type": "text",
      "default": "",
      "placeholder": "Vacío = clave del addon",
      "description": "Tu propia API key de themoviedb.org si la tienes."
    },
    {
      "key": "tmdb_lang",
      "label": "Idioma de metadatos",
      "type": "select",
      "default": "es-ES",
      "options": [
        "es-MX",
        "es-ES",
        "en-US"
      ],
      "description": "es-MX México · es-ES España · en-US English"
    },
    {
      "key": "image_quality",
      "label": "Calidad de posters",
      "type": "select",
      "default": "w500",
      "options": [
        "w185",
        "w342",
        "w500",
        "w780",
        "original"
      ]
    },
    {
      "key": "backdrop_quality",
      "label": "Calidad de backdrops",
      "type": "select",
      "default": "w1280",
      "options": [
        "w780",
        "w1280",
        "original"
      ]
    },
    {
      "key": "region",
      "label": "Región TMDB",
      "type": "text",
      "default": "ES",
      "placeholder": "ES, MX, US, AR…"
    },
    {
      "key": "exclude_in_theater",
      "label": "Ocultar solo-en-cines (solo digital)",
      "type": "select",
      "default": "true",
      "options": [
        "true",
        "false"
      ],
      "description": "Nivel general: no listar títulos que aún no tienen versión digital."
    },
    {
      "key": "include_theater",
      "label": "Mostrar fila En cines en Home",
      "type": "select",
      "default": "false",
      "options": [
        "true",
        "false"
      ]
    },
    {
      "key": "only_digital",
      "label": "Solo fechas ya lanzadas",
      "type": "select",
      "default": "true",
      "options": [
        "true",
        "false"
      ]
    },
    {
      "key": "hide_unreleased_eps",
      "label": "Ocultar capítulos no estrenados",
      "type": "select",
      "default": "true",
      "options": [
        "true",
        "false"
      ]
    },
    {
      "key": "enabled_sources",
      "label": "Extractores activos (coma)",
      "type": "text",
      "default": "embed69,homecine,seriesmetro,cinecalidad,verpelis,vimeus,lamovie,elifilms,tioplus,cine24h,cinemitas,hackstore,areshd,sololatino,pelisgratishd,peliculasflix,entrepeliculasyseries,pelisgo,fuegocine",
      "description": "Quita nombres para desactivar servidores."
    },
    {
      "key": "max_concurrent_sources",
      "label": "Extractores en paralelo",
      "type": "number",
      "default": "4"
    }
  ]
}
